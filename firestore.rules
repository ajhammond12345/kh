rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function adminDoc() {
      return /databases/$(database)/documents/admins/$(request.auth.token.email.lower());
    }

    function isAdmin() {
      return signedIn() && exists(adminDoc());
    }

    function isOwner() {
      return isAdmin() && get(adminDoc()).data.get('role', 'admin') == 'owner';
    }

    function optionalString(data, key, max) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= max);
    }

    match /artworks/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // Public submissions: any signed-in visitor can propose a work; only admins
    // review them. Approval copies the record into artworks/ client-side.
    match /submissions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.submitterEmail == request.auth.token.email.lower()
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.imageBase is string
        && optionalString(request.resource.data, 'description', 5000)
        && optionalString(request.resource.data, 'submitterName', 200);
      allow update, delete: if isAdmin();
    }
  }
}
