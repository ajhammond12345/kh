rules_version = '2';
// Objects are also publicly readable through bucket IAM (allUsers), which is
// how the site renders them; these rules only gate writes from the web SDK.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /uploads/{uploadId}/{size}/{file} {
      allow read: if true;
      // Visitors may add new images but never replace or delete existing ones.
      allow create: if signedIn()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if isAdmin();
    }
  }
}
